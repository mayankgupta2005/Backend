# MongoDB Connection Uri
# Use a live MongoDB Atlas URI for production (e.g. mongodb+srv://...)
# Set MONGO_URL to "mock" to use the built-in mock database for testing/local dev
MONGO_URL=mock
DB_NAME=novashields

# CORS Settings (comma-separated origins)
CORS_ORIGINS=*

# Generative AI (Anthropic Claude API Key for crash diagnostics)
EMERGENT_LLM_KEY=your_claude_api_key_here

# Firebase Service Account JSON file path (for Authentication & FCM)
FIREBASE_SERVICE_ACCOUNT_PATH=path/to/firebase-sdk.json
