# MongoDB Connection Uri
# Use a live MongoDB Atlas URI for production (e.g. mongodb+srv://...)
# Set MONGO_URL to "mock" to use the built-in mock database for testing/local dev
MONGO_URL=mock
DB_NAME=novashields

# CORS Settings (comma-separated origins)
CORS_ORIGINS=*

# Generative AI (Anthropic Claude API Key for crash diagnostics)
EMERGENT_LLM_KEY=your_claude_api_key_here

# Firebase Service Account JSON file path & Database URL
FIREBASE_SERVICE_ACCOUNT_PATH=path/to/firebase-sdk.json
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com/

# Cloudinary Credentials for ESP32 Cam Uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

